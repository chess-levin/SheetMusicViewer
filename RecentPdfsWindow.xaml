<Window x:Class="SheetMusicViewer.RecentPdfsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PDF öffnen" Icon="pack://application:,,,/Assets/icon.png" Width="620" Height="430"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
  <DockPanel Margin="18">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Click="Browse_Click">Andere PDF auswählen…</Button>
      <Button IsDefault="True" Click="OpenSelected_Click">Öffnen</Button>
      <Button IsCancel="True">Abbrechen</Button>
    </StackPanel>
    <StackPanel>
      <TextBlock FontSize="16" FontWeight="SemiBold" Text="Zuletzt geöffnete PDFs" />
      <TextBlock Margin="0,4,0,10" Foreground="DimGray" Text="Eine Datei auswählen oder doppelklicken." />
      <ListBox x:Name="RecentFilesList" MinHeight="260" MouseDoubleClick="RecentFilesList_MouseDoubleClick">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="5,3">
              <TextBlock FontWeight="SemiBold" Text="{Binding FileName}" />
              <TextBlock FontSize="11" Foreground="DimGray" Text="{Binding FullPath}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <TextBlock x:Name="MissingFileNotice" Margin="0,8,0,0" Foreground="#B05A00" TextWrapping="Wrap"
                 Visibility="Collapsed" />
    </StackPanel>
  </DockPanel>
</Window>
