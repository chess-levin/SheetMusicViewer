<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Keep this project independently buildable when the per-user NuGet config has no sources. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
